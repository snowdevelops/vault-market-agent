# Copy to .env (never commit .env) and fill in.
# Absolute path to your Obsidian vault on THIS machine.
VAULT_DIR=/home/youruser/Vault
# The agent's folder inside the vault. The agent can only read and write here.
AGENT_DIR=Business
# Output of: which claude
CLAUDE_BIN=/home/youruser/.local/bin/claude
# Optional: Telegram notifications (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
